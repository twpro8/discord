// Ships backend/worker container logs to Loki via the Docker Engine API
// (no host-filesystem log mount needed). Filtered to only those two
// Compose services — matches this project's "FastAPI application's
// logs" scope, keeps db/redis/adminer/etc. out of Loki.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "backend_logs" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		action        = "keep"
		regex         = "backend|worker"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__meta_docker_container_label_lumiere_environment"]
		target_label  = "environment"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container_name"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.backend_logs.output
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
