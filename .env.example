# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development, testing, production
ENVIRONMENT=development

APP_NAME=Lumiere
STACK_NAME=lumiere-project

# Backend
CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# Auth
JWT_SECRET_KEY=changethis
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=lumiere

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=changethis
REDIS_MAX_CONNECTIONS=50
# seconds before a command times out
REDIS_SOCKET_TIMEOUT=5
# seconds before connection attempt times out
REDIS_SOCKET_CONNECT_TIMEOUT=2
# retry command if socket times out
REDIS_RETRY_ON_TIMEOUT=true

# Emails
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME=Lumiere
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# WebSocket
# Bounded per-connection send queue:
WS_SEND_QUEUE_MAXSIZE=
# Reconnect backoff for the realtime Redis subscription listener:
WS_REDIS_BACKOFF_BASE_SECONDS=
WS_REDIS_BACKOFF_MAX_SECONDS=
WS_REDIS_BACKOFF_JITTER=
# Presence heartbeats:
WS_PRESENCE_HEARTBEAT_INTERVAL_SECONDS=
WS_PRESENCE_STALE_AFTER_SECONDS=
WS_PRESENCE_SWEEP_INTERVAL_SECONDS=

# TURN/STUN (WebRTC NAT traversal for voice calls)
# Empty TURN_* = the credentials endpoint returns STUN-only (fine for most
# home/office networks in dev). For production, set a strong random
# TURN_SECRET_KEY and point TURN_URLS at the coturn service (started via
# `docker compose --profile turn up`, see compose.yml) or a managed TURN
# provider using the same REST-API HMAC credential scheme.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET_KEY=
TURN_CREDENTIAL_TTL_SECONDS=3600
CALL_RING_TIMEOUT_SECONDS=
CALL_ACTIVE_SESSION_TTL_SECONDS=

# Celery broker
CELERY_BROKER_DB=
CELERY_WORKER_CONCURRENCY=
CELERY_WORKER_PREFETCH_MULTIPLIER=
CELERY_TASK_MAX_RETRIES=
CELERY_TASK_DEFAULT_RETRY_DELAY=

# Cloudflare R2 object storage (S3-compatible API).
# Empty credentials = storage not configured; the app runs without it.
# Get these from Cloudflare: R2 dashboard -> Manage API Tokens -> Create token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public object URL base: R2 public bucket dev URL (https://pub-<hash>.r2.dev)
# or a custom domain bound to the bucket. Empty = public_url() unavailable.
R2_PUBLIC_BASE_URL=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# Observability (opt-in): docker compose --profile observability up -d
# Grafana admin login — see development.md.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changethis
